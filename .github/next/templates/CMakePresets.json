{
  "version": 6,
  "cmakeMinimumRequired": {
    "major": 3,
    "minor": 25,
    "patch": 0
  },
  "configurePresets": [
    {
      "name": "llvm18-dev",
      "displayName": "CVite LLVM 18 development",
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build/llvm18-dev",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug",
        "CMAKE_C_COMPILER": "/usr/bin/clang-18",
        "CMAKE_CXX_COMPILER": "/usr/bin/clang++-18",
        "CVITE_BUILD_COMPILER": "ON",
        "CVITE_BUILD_LLVM_PASS": "ON",
        "CVITE_BUILD_ORC_LOADER": "ON",
        "CVITE_LIBCLANG_ROOT": "/usr/lib/llvm-18",
        "LLVM_DIR": "/usr/lib/llvm-18/lib/cmake/llvm",
        "CVITE_WARNINGS_AS_ERRORS": "ON"
      }
    },
    {
      "name": "llvm18-sanitize",
      "displayName": "CVite LLVM 18 ASan/UBSan",
      "inherits": "llvm18-dev",
      "binaryDir": "${sourceDir}/build/llvm18-sanitize",
      "cacheVariables": {
        "CMAKE_C_FLAGS": "-fsanitize=address,undefined -fno-omit-frame-pointer",
        "CMAKE_CXX_FLAGS": "-fsanitize=address,undefined -fno-omit-frame-pointer",
        "CMAKE_EXE_LINKER_FLAGS": "-fsanitize=address,undefined"
      }
    }
  ],
  "buildPresets": [
    {
      "name": "llvm18-dev",
      "configurePreset": "llvm18-dev"
    },
    {
      "name": "llvm18-sanitize",
      "configurePreset": "llvm18-sanitize"
    }
  ],
  "testPresets": [
    {
      "name": "llvm18-dev",
      "configurePreset": "llvm18-dev",
      "output": {
        "outputOnFailure": true
      }
    },
    {
      "name": "llvm18-sanitize",
      "configurePreset": "llvm18-sanitize",
      "environment": {
        "ASAN_OPTIONS": "detect_leaks=1:strict_string_checks=1",
        "UBSAN_OPTIONS": "print_stacktrace=1:halt_on_error=1"
      },
      "output": {
        "outputOnFailure": true
      }
    }
  ]
}
